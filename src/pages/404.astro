---
import Base from '../layouts/Base.astro';
import { site, nav } from '../config/site';
---

<Base title={`Page not found | ${site.name}`} description="The page you were looking for could not be found." slug="404">
  <section class="block hero page-404">
    <div class="container hero-inner">
      <h1>Page not found</h1>
      <p>The page you were looking for doesn’t exist. Try one of these instead:</p>
      <ul class="notfound-links">
        {nav.map((n) => <li><a class="cta-link" href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>
